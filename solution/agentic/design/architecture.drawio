<mxfile host="app.diagrams.net" agent="generated" version="24.0.0"><diagram id="page-architecture" name="System architecture"><mxGraphModel adaptiveColors="auto" dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1850" pageHeight="1100" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="title" value="UDA-Hub support orchestrator: system architecture" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=18;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="40" y="10" width="900" height="36" as="geometry"/></mxCell><mxCell id="cust" value="Customer&lt;br&gt;(chat)" style="shape=umlActor;verticalLabelPosition=bottom;verticalAlign=top;html=1;outlineConnect=0;fontSize=11;" vertex="1" parent="1"><mxGeometry x="70" y="120" width="40" height="80" as="geometry"/></mxCell><mxCell id="orch" value="LangGraph orchestrator (agentic/workflow.py): one graph run per customer message" style="swimlane;startSize=28;html=1;rounded=1;arcSize=2;fillColor=#f8f9fa;strokeColor=#9aa0a6;fontStyle=1;fontSize=13;collapsible=0;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="210" y="60" width="1340" height="260" as="geometry"/></mxCell><mxCell id="hub" value="&lt;b&gt;Orchestrator hub&lt;/b&gt;&lt;br&gt;router: picks the next step from the saved state (phase, classification, ticket, memory)" style="rounded=1;whiteSpace=wrap;html=1;fontSize=11;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=12;" vertex="1" parent="orch"><mxGeometry x="20" y="45" width="220" height="110" as="geometry"/></mxCell><mxCell id="ownlabel" value="&lt;b&gt;Orchestrator's own steps&lt;/b&gt; (LLM calls, no tools)" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=11;" vertex="1" parent="orch"><mxGeometry x="270" y="38" width="480" height="20" as="geometry"/></mxCell><mxCell id="intake" value="&lt;b&gt;Intake&lt;/b&gt;&lt;br&gt;asks the 4 questions" style="rounded=1;whiteSpace=wrap;html=1;fontSize=11;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="orch"><mxGeometry x="270" y="65" width="150" height="55" as="geometry"/></mxCell><mxCell id="recall" value="&lt;b&gt;Recall memory&lt;/b&gt;&lt;br&gt;history, preferences" style="rounded=1;whiteSpace=wrap;html=1;fontSize=11;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="orch"><mxGeometry x="430" y="65" width="150" height="55" as="geometry"/></mxCell><mxCell id="respond" value="&lt;b&gt;Respond&lt;/b&gt;&lt;br&gt;writes the reply" style="rounded=1;whiteSpace=wrap;html=1;fontSize=11;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="orch"><mxGeometry x="590" y="65" width="150" height="55" as="geometry"/></mxCell><mxCell id="confirm" value="&lt;b&gt;Confirm&lt;/b&gt;&lt;br&gt;did the fix work?" style="rounded=1;whiteSpace=wrap;html=1;fontSize=11;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="orch"><mxGeometry x="270" y="135" width="150" height="55" as="geometry"/></mxCell><mxCell id="followup" value="&lt;b&gt;Follow-up&lt;/b&gt;&lt;br&gt;adds messages to ticket" style="rounded=1;whiteSpace=wrap;html=1;fontSize=11;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="orch"><mxGeometry x="430" y="135" width="150" height="55" as="geometry"/></mxCell><mxCell id="deliver" value="&lt;b&gt;Deliver&lt;/b&gt;&lt;br&gt;records and sends reply" style="rounded=1;whiteSpace=wrap;html=1;fontSize=11;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="orch"><mxGeometry x="590" y="135" width="150" height="55" as="geometry"/></mxCell><mxCell id="state" value="&lt;b&gt;TicketState&lt;/b&gt; (saved per thread_id)&lt;br&gt;messages, phase, intake, classification, user_id, ticket_id, kb, memory, escalation reason" style="rounded=1;whiteSpace=wrap;html=1;fontSize=11;fillColor=#fff;strokeColor=#9aa0a6;dashed=1;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;" vertex="1" parent="orch"><mxGeometry x="780" y="45" width="260" height="100" as="geometry"/></mxCell><mxCell id="ckpt" value="&lt;b&gt;SQLite checkpointer&lt;/b&gt;&lt;br&gt;keeps each conversation across restarts" style="rounded=1;whiteSpace=wrap;html=1;fontSize=11;fillColor=#fff;strokeColor=#9aa0a6;dashed=1;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;" vertex="1" parent="orch"><mxGeometry x="780" y="160" width="260" height="50" as="geometry"/></mxCell><mxCell id="rules" value="&lt;b&gt;Escalate to a human when&lt;/b&gt;&lt;br&gt;- the account is blocked&lt;br&gt;- urgency high and complexity complex&lt;br&gt;- no confident knowledge base answer (score below 0.32)&lt;br&gt;- the customer says the fix failed&lt;br&gt;- recurring issue (2 earlier fixes)" style="rounded=1;whiteSpace=wrap;html=1;fontSize=11;fillColor=#fff;strokeColor=#9aa0a6;dashed=1;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;" vertex="1" parent="orch"><mxGeometry x="1060" y="45" width="260" height="165" as="geometry"/></mxCell><mxCell id="agents" value="Specialist agents (ReAct agents on gpt-4o-mini, each bound only to its own MCP tools)" style="swimlane;startSize=28;html=1;rounded=1;arcSize=2;fillColor=#f8f9fa;strokeColor=#9aa0a6;fontStyle=1;fontSize=13;collapsible=0;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="210" y="350" width="1340" height="175" as="geometry"/></mxCell><mxCell id="a_class" value="&lt;b&gt;ClassifierAgent&lt;/b&gt;&lt;br&gt;Labels the ticket: category, urgency, complexity (structured output).&lt;br&gt;&lt;i&gt;No tools&lt;/i&gt;" style="rounded=1;whiteSpace=wrap;html=1;fontSize=11;fillColor=#dae8fc;strokeColor=#6c8ebf;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;" vertex="1" parent="agents"><mxGeometry x="20" y="45" width="240" height="110" as="geometry"/></mxCell><mxCell id="a_acct" value="&lt;b&gt;AccountOperationsAgent&lt;/b&gt;&lt;br&gt;Finds the customer by email, id or name; reads subscription, reservations and events; blocks or unblocks accounts.&lt;br&gt;&lt;i&gt;8 tools (CultPass)&lt;/i&gt;" style="rounded=1;whiteSpace=wrap;html=1;fontSize=11;fillColor=#dae8fc;strokeColor=#6c8ebf;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;" vertex="1" parent="agents"><mxGeometry x="282" y="45" width="240" height="110" as="geometry"/></mxCell><mxCell id="a_desk" value="&lt;b&gt;ServiceDeskAgent&lt;/b&gt;&lt;br&gt;Creates tickets, sets their status, records messages, reads ticket history.&lt;br&gt;&lt;i&gt;7 tools (UDA-Hub)&lt;/i&gt;" style="rounded=1;whiteSpace=wrap;html=1;fontSize=11;fillColor=#dae8fc;strokeColor=#6c8ebf;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;" vertex="1" parent="agents"><mxGeometry x="544" y="45" width="240" height="110" as="geometry"/></mxCell><mxCell id="a_res" value="&lt;b&gt;ResolverAgent&lt;/b&gt;&lt;br&gt;Searches the knowledge base and answers only from the articles it finds.&lt;br&gt;&lt;i&gt;1 tool (UDA-Hub)&lt;/i&gt;" style="rounded=1;whiteSpace=wrap;html=1;fontSize=11;fillColor=#dae8fc;strokeColor=#6c8ebf;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;" vertex="1" parent="agents"><mxGeometry x="806" y="45" width="240" height="110" as="geometry"/></mxCell><mxCell id="a_esc" value="&lt;b&gt;EscalationAgent&lt;/b&gt;&lt;br&gt;Writes the hand-off note and notifies a human, exactly once.&lt;br&gt;&lt;i&gt;1 tool (UDA-Hub)&lt;/i&gt;" style="rounded=1;whiteSpace=wrap;html=1;fontSize=11;fillColor=#dae8fc;strokeColor=#6c8ebf;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;" vertex="1" parent="agents"><mxGeometry x="1068" y="45" width="240" height="110" as="geometry"/></mxCell><mxCell id="mcp" value="MCP toolbox (in-memory FastMCP servers)" style="swimlane;startSize=28;html=1;rounded=1;arcSize=2;fillColor=#f8f9fa;strokeColor=#9aa0a6;fontStyle=1;fontSize=13;collapsible=0;whiteSpace=wrap;align=left;spacingLeft=10;" vertex="1" parent="1"><mxGeometry x="210" y="555" width="1340" height="225" as="geometry"/></mxCell><mxCell id="mcpnote" value="Tools are loaded with langchain-mcp-adapters and handed to each agent by name." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=11;" vertex="1" parent="mcp"><mxGeometry x="340" y="190" width="640" height="22" as="geometry"/></mxCell><mxCell id="s_cult" value="&lt;b&gt;CultPass server&lt;/b&gt; (the customer's system)&lt;br&gt;&lt;br&gt;lookup_user_account&lt;br&gt;lookup_user_by_name&lt;br&gt;lookup_user_by_email&lt;br&gt;get_reservations, get_subscriptions, get_experience&lt;br&gt;set_blocked, set_unblocked" style="rounded=1;whiteSpace=wrap;html=1;fontSize=11;fillColor=#d5e8d4;strokeColor=#82b366;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;" vertex="1" parent="mcp"><mxGeometry x="20" y="45" width="590" height="140" as="geometry"/></mxCell><mxCell id="s_uda" value="&lt;b&gt;UDA-Hub server&lt;/b&gt; (the support platform)&lt;br&gt;&lt;br&gt;get_support_user, get_support_user_by_external_id&lt;br&gt;get_ticket_history, get_open_tickets&lt;br&gt;create_ticket, update_ticket, add_ticket_message&lt;br&gt;get_customer_memory, save_customer_memory&lt;br&gt;get_knowledge_articles (sqlite-vec search), escalate_to_human&lt;br&gt;&lt;i&gt;The orchestrator also calls the memory tools and get_ticket_history directly.&lt;/i&gt;" style="rounded=1;whiteSpace=wrap;html=1;fontSize=11;fillColor=#d5e8d4;strokeColor=#82b366;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;" vertex="1" parent="mcp"><mxGeometry x="640" y="45" width="680" height="140" as="geometry"/></mxCell><mxCell id="db_cult" value="&lt;b&gt;cultpass.db&lt;/b&gt;&lt;br&gt;users, subscriptions,&lt;br&gt;experiences, reservations" style="shape=cylinder3;whiteSpace=wrap;html=1;boundedLbl=1;backgroundOutline=1;size=12;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=11;" vertex="1" parent="1"><mxGeometry x="330" y="820" width="230" height="120" as="geometry"/></mxCell><mxCell id="db_uda" value="&lt;b&gt;udahub.db&lt;/b&gt;&lt;br&gt;accounts, users, tickets, ticket_metadata,&lt;br&gt;ticket_messages, knowledge,&lt;br&gt;customer_memory, vec_knowledge" style="shape=cylinde