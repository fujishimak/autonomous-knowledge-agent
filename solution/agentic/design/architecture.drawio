Desk&lt;br&gt;Agent" style="swimlane;horizontal=0;startSize=130;html=1;fillColor=#f8f9fa;strokeColor=#9aa0a6;fontStyle=1;fontSize=12;whiteSpace=wrap;collapsible=0;" vertex="1" parent="1"><mxGeometry x="40" y="580" width="2250" height="110" as="geometry"/></mxCell><mxCell id="lane_res" value="Resolver&lt;br&gt;Agent" style="swimlane;horizontal=0;startSize=130;html=1;fillColor=#f8f9fa;strokeColor=#9aa0a6;fontStyle=1;fontSize=12;whiteSpace=wrap;collapsible=0;" vertex="1" parent="1"><mxGeometry x="40" y="690" width="2250" height="110" as="geometry"/></mxCell><mxCell id="lane_esc" value="Escalation&lt;br&gt;Agent" style="swimlane;horizontal=0;startSize=130;html=1;fillColor=#f8f9fa;strokeColor=#9aa0a6;fontStyle=1;fontSize=12;whiteSpace=wrap;collapsible=0;" vertex="1" parent="1"><mxGeometry x="40" y="800" width="2250" height="110" as="geometry"/></mxCell><mxCell id="n_msg" value="Customer sends a message" style="rounded=1;whiteSpace=wrap;html=1;fontSize=11;fillColor=#fff;strokeColor=#666666;" vertex="1" parent="lane_cust"><mxGeometry x="150" y="20" width="130" height="60" as="geometry"/></mxCell><mxCell id="c_ask" value="Customer is asked for the missing details" style="rounded=1;whiteSpace=wrap;html=1;fontSize=11;fillColor=#fff;strokeColor=#666666;" vertex="1" parent="lane_cust"><mxGeometry x="450" y="20" width="130" height="60" as="geometry"/></mxCell><mxCell id="c_reply" value="Customer receives the reply" style="rounded=1;whiteSpace=wrap;html=1;fontSize=11;fillColor=#fff;strokeColor=#666666;" vertex="1" parent="lane_cust"><mxGeometry x="2100" y="20" width="130" height="60" as="geometry"/></mxCell><mxCell id="n_intake" value="&lt;b&gt;Intake&lt;/b&gt;&lt;br&gt;extract issue, when, activity, name, email" style="rounded=1;whiteSpace=wrap;html=1;fontSize=11;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="lane_orch"><mxGeometry x="150" y="20" width="130" height="70" as="geometry"/></mxCell><mxCell id="d_complete" value="All 4 answers given?" style="rhombus;whiteSpace=wrap;html=1;fontSize=11;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="lane_orch"><mxGeometry x="300" y="10" width="130" height="90" as="geometry"/></mxCell><mxCell id="n_ask" value="&lt;b&gt;Ask&lt;/b&gt; only for what is missing" style="rounded=1;whiteSpace=wrap;html=1;fontSize=11;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="lane_orch"><mxGeometry x="450" y="125" width="130" height="60" as="geometry"/></mxCell><mxCell id="n_recall" value="&lt;b&gt;Recall memory&lt;/b&gt;&lt;br&gt;past tickets, preferences, earlier fixes" style="rounded=1;whiteSpace=wrap;html=1;fontSize=11;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="lane_orch"><mxGeometry x="1050" y="20" width="130" height="70" as="geometry"/></mxCell><mxCell id="d_esc" value="Escalate?" style="rhombus;whiteSpace=wrap;html=1;fontSize=11;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="lane_orch"><mxGeometry x="1350" y="10" width="130" height="90" as="geometry"/></mxCell><mxCell id="n_respond" value="&lt;b&gt;Respond&lt;/b&gt;&lt;br&gt;offer the fix and ask if it worked, or hand-off message" style="rounded=1;whiteSpace=wrap;html=1;fontSize=11;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="lane_orch"><mxGeometry x="1800" y="20" width="130" height="70" as="geometry"/></mxCell><mxCell id="n_class" value="&lt;b&gt;Classify&lt;/b&gt;&lt;br&gt;category, urgency, complexity" style="rounded=1;whiteSpace=wrap;html=1;fontSize=11;fillColor=#dae8fc;strokeColor=#6c8ebf;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;" vertex="1" parent="lane_class"><mxGeometry x="600" y="25" width="130" height="60" as="geometry"/></mxCell><mxCell id="n_acct" value="&lt;b&gt;Find the customer&lt;/b&gt; by email: user id, blocked?" style="rounded=1;whiteSpace=wrap;html=1;fontSize=11;fillColor=#dae8fc;strokeColor=#6c8ebf;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;" vertex="1" parent="lane_acct"><mxGeometry x="750" y="25" width="130" height="60" as="geometry"/></mxCell><mxCell id="n_ticket" value="&lt;b&gt;Create ticket&lt;/b&gt; (status in_progress)" style="rounded=1;whiteSpace=wrap;html=1;fontSize=11;fillColor=#dae8fc;strokeColor=#6c8ebf;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;" vertex="1" parent="lane_desk"><mxGeometry x="900" y="25" width="130" height="60" as="geometry"/></mxCell><mxCell id="n_status" value="&lt;b&gt;Set status&lt;/b&gt; escalated" style="rounded=1;whiteSpace=wrap;html=1;fontSize=11;fillColor=#dae8fc;strokeColor=#6c8ebf;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;" vertex="1" parent="lane_desk"><mxGeometry x="1650" y="25" width="130" height="60" as="geometry"/></mxCell><mxCell id="n_record" value="&lt;b&gt;Record the reply&lt;/b&gt; on the ticket" style="rounded=1;whiteSpace=wrap;html=1;fontSize=11;fillColor=#dae8fc;strokeColor=#6c8ebf;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;" vertex="1" parent="lane_desk"><mxGeometry x="1950" y="25" width="130" height="60" as="geometry"/></mxCell><mxCell id="n_kb" value="&lt;b&gt;Search knowledge base&lt;/b&gt;, answer from articles, score" style="rounded=1;whiteSpace=wrap;html=1;fontSize=11;fillColor=#dae8fc;strokeColor=#6c8ebf;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;" vertex="1" parent="lane_res"><mxGeometry x="1200" y="25" width="130" height="60" as="geometry"/></mxCell><mxCell id="n_notify" value="&lt;b&gt;Notify a human&lt;/b&gt; (escalate_to_human, once)" style="rounded=1;whiteSpace=wrap;html=1;fontSize=11;fillColor=#dae8fc;strokeColor=#6c8ebf;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;" vertex="1" parent="lane_esc"><mxGeometry x="1500" y="25" width="130" height="60" as="geometry"/></mxCell><mxCell id="m1" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=11;endArrow=block;endFill=1;strokeWidth=2;strokeColor=#333333;" edge="1" parent="1" source="n_msg" target="n_intake"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="m2" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=11;endArrow=block;endFill=1;strokeWidth=2;strokeColor=#333333;" edge="1" parent="1" source="n_intake" target="d_complete"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="m3" value="no" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=11;endArrow=block;endFill=1;strokeWidth=2;strokeColor=#333333;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="d_complete" target="n_ask"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="m4" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=11;endArrow=block;endFill=1;strokeWidth=2;strokeColor=#333333;exitX=0.5;exitY=0;exitDx=0;exitDy=0;entryX=0.5;entryY=1;entryDx=0;entryDy=0;" edge="1" parent="1" source="n_ask" target="c_ask"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="m5" value="yes" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=11;endArrow=block;endFill=1;strokeWidth=2;strokeColor=#333333;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="d_complete" target="n_class"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="m6" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=11;endArrow=block;endFill=1;strokeWidth=2;strokeColor=#333333;" edge="1" parent="1" source="n_class" target="n_acct"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="m7" value="found" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=11;endArrow=block;endFill=1;strokeWidth=2;strokeColor=#333333;" edge="1" parent="1" source="n_acct" target="n_ticket"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="m8" value="email not found" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=11;endArrow=block;endFill=1;strokeWidth=2;strokeColor=#333333;exitX=0;exitY=0.5;exitDx=0;exitDy=0;entryX=0.5;entryY=1;entryDx=0;entryDy=0;" edge="1" parent="1" source="n_acct" target="n_ask"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="m9" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=11;endArrow=block;endFill=1;strokeWidth=2;strokeColor=#333333;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="n_ticket" target="n_recall"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="m10" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=11;endArrow=block;endFill=1;strokeWidth=2;strokeColor=#333333;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="n_recall" target="n_kb"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="m11" value="blocked or recurring" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=11;endArrow=block;endFill=1;strokeWidth=2;strokeColor=#333333;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="n_recall" target="d_esc"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="m12" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=11;endArrow=block;endFill=1;strokeWidth=2;strokeColor=#333333;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="n_kb" target="d_esc"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="m13" value="yes" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=11;endArrow=block;endFill=1;strokeWidth=2;strokeColor=#333333;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="d_esc" target="n_notify"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="m14" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=11;endArrow=block;endFill=1;strokeWidth=2;strokeColor=#333333;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0.5;entryY=1;entryDx=0;entryDy=0;" edge="1" parent="1" source="n_notify" target="n_status"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="m15" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=11;endArrow=block;endFill=1;strokeWidth=2;strokeColor=#333333;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0.5;entryY=1;entryDx=0;entryDy=0;" edge="1" parent="1" source="n_status" target="n_respond"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="m16" value="no" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=11;endArrow=block;endFill=1;strokeWidth=2;strokeColor=#333333;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="d_esc" target="n_respond"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="m17" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=11;endArrow=block;endFill=1;strokeWidth=2;strokeColor=#333333;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="n_respond" target="n_record"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="m18" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=11;endArrow=block;endFill=1;strokeWidth=2;strokeColor=#333333;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0.5;entryY=1;entryDx=0;entryDy=0;" edge="1" parent="1" source="n_record" target="c_reply"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="note2" value="&lt;b&gt;Reading the diagram&lt;/b&gt;&lt;br&gt;Every step returns to the hub, which picks the next one from the saved state; those return arrows are not drawn.&lt;br&gt;&lt;b&gt;Escalate? is yes when&lt;/b&gt; the account is blocked, the issue is recurring, urgency is high and complexity complex, or the best knowledge base score is below 0.32. Blocked and recurring cases skip the knowledge base search.&lt;br&gt;Ids (user id, ticket id) are read from tool results, never from an agent's wording." style="rounded=1;whiteSpace=wrap;html=1;fontSize=11;fillColor=#fff;strokeColor=#9aa0a6;dashed=1;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;" vertex="1" parent="1"><mxGeometry x="40" y="940" width="1300" height="100" as="geometry"/></mxCell></root></mxGraphModel></diagram><diagram id="page-phases" name="Conversation phases"><mxGraphModel adaptiveColors="auto" dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1600" pageHeight="700" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="title3" value="Conversation phases: what happens on each later message" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=18;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="40" y="10" width="900" height="36" as="geometry"/></mxCell><mxCell id="start" value="" style="ellipse;html=1;fillColor=#333333;strokeColor=#333333;" vertex="1" parent="1"><mxGeometry x="30" y="245" width="26" height="26" as="geometry"/></mxCell><mxCell id="s_intake" value="&lt;b&gt;intake&lt;/b&gt;&lt;br&gt;collecting the 4 answers&lt;br&gt;&lt;i&gt;Intake step&lt;/i&gt;" style="rounded=1;whiteSpace=wrap;html=1;fontSize=11;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=12;" vertex="1" parent="1"><mxGeometry x="170" y="220" width="190" height="80" as="geometry"/></mxCell><mxCell id="s_proc" value="&lt;b&gt;processing&lt;/b&gt;&lt;br&gt;classify, find account, create ticket, recall memory, search, escalate or respond&lt;br&gt;&lt;i&gt;runs inside one turn&lt;/i&gt;" style="rounded=1;whiteSpace=wrap;html=1;fontSize=11;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=12;" vertex="1" parent="1"><mxGeometry x="480" y="210" width="250" height="100" as="geometry"/></mxCell><mxCell id="s_wait" value="&lt;b&gt;awaiting_confirmation&lt;/b&gt;&lt;br&gt;fix sent, waiting for yes or no&lt;br&gt;&lt;i&gt;Confirm step&lt;/i&gt;" style="rounded=1;whiteSpace=wrap;html=1;fontSize=11;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=12;" vertex="1" parent="1"><mxGeometry x="860" y="80" width="230" height="80" as="geometry"/></mxCell><mxCell id="s_esc" value="&lt;b&gt;escalated&lt;/b&gt;&lt;br&gt;a human has the ticket; new messages are added to it&lt;br&gt;&lt;i&gt;Follow-up step&lt;/i&gt;" style="rounded=1;whiteSpace=wrap;html=1;fontSize=11;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=12;" vertex="1" parent="1"><mxGeometry x="860" y="370" width="230" height="90" as="geometry"/></mxCell><mxCell id="s_closed" value="&lt;b&gt;closed&lt;/b&gt;&lt;br&gt;ticket resolved, memory saved" style="rounded=1;whiteSpace=wrap;html=1;fontSize=11;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=12;" vertex="1" parent="1"><mxGeometry x="1290" y="80" width="200" height="80" as="geometry"/></mxCell><mxCell id="t0" value="first message" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=11;endArrow=block;endFill=1;strokeWidth=2;strokeColor=#333333;" edge="1" parent="1" source="start" target="s_intake"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="t1" value="all 4 answers given" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=11;endArrow=block;endFill=1;strokeWidth=2;strokeColor=#333333;" edge="1" parent="1" source="s_intake" target="s_proc"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="t2" value="fix offered" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=11;endArrow=block;endFill=1;strokeWidth=2;strokeColor=#333333;exitX=0.5;exitY=0;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="s_proc" target="s_wait"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="t3" value="escalation triggered" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=11;endArrow=block;endFill=1;strokeWidth=2;strokeColor=#333333;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="s_proc" target="s_esc"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="t4" value="customer says yes" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=11;endArrow=block;endFill=1;strokeWidth=2;strokeColor=#333333;" edge="1" parent="1" source="s_wait" target="s_closed"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="t5" value="customer says no" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=11;endArrow=block;endFill=1;strokeWidth=2;strokeColor=#333333;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="s_wait" target="s_esc"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="n_intake" value="Stays in &lt;b&gt;intake&lt;/b&gt; until every answer, including a valid email that matches a CultPass account, is given." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=11;" vertex="1" parent="1"><mxGeometry x="150" y="320" width="250" height="70" as="geometry"/></mxCell><mxCell id="n_wait" value="&lt;b&gt;unclear&lt;/b&gt; reply (for example a question): answered briefly, then asked again." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=11;" vertex="1" parent="1"><mxGeometry x="860" y="15" width="300" height="50" as="geometry"/></mxCell><mxCell id="n_closed" value="A new message after &lt;b&gt;closed&lt;/b&gt; starts a new ticket for the same customer (name and email are kept)." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=11;" vertex="1" parent="1"><mxGeometry x="1290" y="170" width="240" height="70" as="geometry"/></mxCell><mxCell id="legend3" value="&lt;b&gt;Where the phase is kept&lt;/b&gt;&lt;br&gt;In the graph state, saved by the SQLite checkpointer per thread_id, so a conversation continues after a restart. Replies and customer messages are also recorded on the ticket." style="rounded=1;whiteSpace=wrap;html=1;fontSize=11;fillColor=#fff;strokeColor=#9aa0a6;dashed=1;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;" vertex="1" parent="1"><mxGeometry x="170" y="540" width="520" height="90" as="geometry"/></mxCell><mxCell id="legend3b" value="&lt;b&gt;What is remembered after a ticket is resolved&lt;/b&gt;&lt;br&gt;The resolved issue (category and fix) and stated preferences (language, contact method) are saved in customer_memory and used in later conversations." style="rounded=1;whiteSpace=wrap;html=1;fontSize=11;fillColor=#fff;strokeColor=#9aa0a6;dashed=1;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;" vertex="1" parent="1"><mxGeometry x="740" y="540" width="520" height="90" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>